# Copy to your shell or Compose --env-file. Never commit actual secrets.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password
POSTGRES_MIGRATION_PASSWORD=replace-with-a-different-url-safe-random-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-different-random-bootstrap-password
# Optional personal research only. No redistribution rights are implied.
CADRISYN_MARKET_DATA_ENABLED=false
CADRISYN_YAHOO_PERSONAL_USE_ACKNOWLEDGED=false
CADRISYN_EOD_GRACE_HOURS=4
CADRISYN_LEGACY_ENABLED=false
# Preserved experimental agent services, outside the workspace startup.
REDIS_URL=redis://localhost:6379
MONGO_URI=mongodb://localhost:27017/stock_memory
API_KEY=changeme
