CADRISYN_RELEASE_PROFILE=demo
CADRISYN_WEB_RELEASE_PROFILE=demo
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=research.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://research.example.invalid
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret
DATABASE_URL_FILE=/run/secrets/database_url
DJANGO_CACHE_URL_FILE=/run/secrets/cache_url
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_TRUST_X_FORWARDED_PROTO=true
CADRISYN_TRUST_REQUEST_ID=true
CADRISYN_TRUST_CLIENT_IP=true
CADRISYN_LEGACY_ENABLED=false
CADRISYN_ADMIN_ENABLED=false
CADRISYN_MARKET_DATA_ENABLED=false
CADRISYN_LEGACY_SCHEDULER_ENABLED=false
API_IMAGE=registry.example.invalid/cadrisyn-api@sha256:REPLACE_WITH_VERIFIED_DIGEST
WEB_IMAGE=registry.example.invalid/cadrisyn-web@sha256:REPLACE_WITH_VERIFIED_DIGEST
